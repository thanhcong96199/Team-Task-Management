{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Tools like the shadcn CLI only read this root file to resolve the "@" alias;
  // keep it in sync with "paths" in tsconfig.app.json
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
